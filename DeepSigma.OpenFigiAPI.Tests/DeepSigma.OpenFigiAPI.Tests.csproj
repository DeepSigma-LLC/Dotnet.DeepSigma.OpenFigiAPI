<Project Sdk="Microsoft.NET.Sdk">

  <!-- An xUnit v3 test program (Microsoft.Testing.Platform, see global.json). The saved responses in TestData are
       copied beside it, so the parsers are tested without a web request. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSigma.OpenFigiAPI\DeepSigma.OpenFigiAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
